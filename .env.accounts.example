# Local-only PCC authentication fixture catalog.
# Copy to ignored .env.accounts when onsite auth implementation starts.
# This is a future auth-seeder input, not Compose runtime configuration.
# It is intentionally limited to account identity and login fixtures: no profiles, teams,
# communities, tournaments, matches, wallets, biometrics, payments, or certificates.

PCC_AUTH_SEED_ENABLED=true
PCC_AUTH_SEED_SCHEMA_VERSION=1
PCC_AUTH_SEED_ENVIRONMENT=development
# Local test-only credential; never enable this catalog on staging or production.
PCC_AUTH_SEED_PASSWORD=PccAuthFixture2026!
PCC_AUTH_SEED_ACCOUNT_COUNT=24

# Record format: fixture_key|email|real_name|role
PCC_AUTH_SEED_ACCOUNT_01=player-01|player01@auth.seed.balangkas.invalid|PCC Fixture Player 01|PLAYER
