# Explicit target values; no inherited server identity
PCC_DOMAIN=pcc.example.invalid
STAGING_SSH_HOST=
STAGING_SSH_USER=
STAGING_SSH_PORT=22
# Absolute local path to the ignored private SSH key PEM for routine staging access.
# The PEM bytes stay outside this repository and are never pasted into an environment file.
STAGING_SSH_KEY_PATH=
STAGING_DEPLOY_DIRECTORY=
# Optional root-level maintenance identity; use only for an explicitly authorized host task.
STAGING_ADMIN_SSH_USER=
# Absolute local path to the ignored private administrator SSH key PEM.
STAGING_ADMIN_SSH_KEY_PATH=
# Required only to pull private ghcr.io images. The named GitHub account must have package-read access.
# GITHUB_PAT is a GitHub classic PAT limited to read:packages; it never enters Compose or application env.
GITHUB_USERNAME=
GITHUB_PAT=
# Onsite values must be immutable registry digest references recorded in the release record,
# for example: registry.example.invalid/balangkas-pcc/frontend@sha256:<64-hex-digest>
FRONTEND_IMAGE=pcc-unbuilt-frontend:preparation
BACKEND_IMAGE=pcc-unbuilt-backend:preparation
WORKER_IMAGE=pcc-unbuilt-worker:preparation
TLS_CERT_DIRECTORY=./certbot/conf
TLS_CHALLENGE_DIRECTORY=./certbot/www
# Do not put a Solana signer variable or bytes here. After Devnet release gates pass,
# manually provision ignored ./secrets/solana-operator.json; Compose mounts secrets read-only
# into the worker and .env.application uses PCC_SOLANA_OPERATOR_SIGNER_PATH.
