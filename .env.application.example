# Future application configuration, inactive during preparation
PCC_ENVIRONMENT=staging
PCC_PUBLIC_ORIGIN=https://pcc.example.invalid
# Replace only the password segment with the URL-encoded value of ignored POSTGRES_PASSWORD.
DATABASE_URL=postgresql+asyncpg://pcc:replace-with-postgres-password@postgres:5432/pcc
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=pcc-local
# Must equal the ignored MINIO_ROOT_PASSWORD; do not commit a real value.
MINIO_SECRET_KEY=replace-with-minio-root-password
MINIO_BUCKET=pcc-assets
PCC_UPLOAD_MAX_BYTES=12582912
# Replace with a unique, high-entropy secret in ignored application configuration.
PCC_SESSION_SIGNING_KEY=replace-with-at-least-32-random-bytes
PCC_SESSION_TTL_SECONDS=86400
PCC_CSRF_TOKEN_TTL_SECONDS=86400
PCC_OPENAPI_EXPOSED=true
PCC_HACKATHON_DEMO_OTP_ENABLED=true
# User-authorized staging cheat code; non-secret and never real verification evidence.
PCC_HACKATHON_DEMO_OTP_CODE=123456
PCC_MAINTENANCE_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=parocha.johnmathew23@gmail.com
CHALLONGE_USERNAME=MaChewww
CHALLONGE_API_KEY=

# Manually provisioned host file mounted read-only at /models; do not put the hash here.
# Its fixed SHA-256 is the approved identity in docs/FACE_RECOGNITION_MODEL.md.
PCC_FACE_MODEL_PATH=/models/face-recognition/w600k_r50.onnx
# User-selected hackathon intent preselects biometric use. This template is not evidence of
# InsightFace rights or a verified Human browser-capture asset/pipeline; runtime must fail closed.
PCC_BIOMETRIC_ENABLED=true
PCC_BIOMETRIC_USAGE_APPROVED=true
# The API checks the reported Human package/policy; frontend assets are served from this same origin.
PCC_BIOMETRIC_HUMAN_VERSION=3.3.6
PCC_BIOMETRIC_CAPTURE_POLICY_VERSION=human-blink-v1
NEXT_PUBLIC_HUMAN_MODELS_PATH=/biometric-models/human
PCC_BIOMETRIC_MAX_BYTES=2097152
PCC_BIOMETRIC_MAX_PIXELS=4194304
PCC_BIOMETRIC_MAX_CONCURRENT_INFERENCES=1
PCC_BIOMETRIC_TIMEOUT_SECONDS=30

# All scoreboard runtime files are manually provisioned under the read-only /models mount.
# Artifact identities live in docs/MLBB_SCOREBOARD_EXTRACTION.md, never in environment values.
# User-selected hackathon intent preselects extraction use. This template is not evidence of
# checkpoint provenance/rights or locally provisioned PaddleOCR assets; runtime must fail closed.
PCC_SCOREBOARD_EXTRACTION_ENABLED=true
PCC_SCOREBOARD_USAGE_APPROVED=true
PCC_SCOREBOARD_RFDETR_MODEL_PATH=/models/scoreboard/roboflow_weights.pt
PCC_SCOREBOARD_PADDLE_MODELS_ROOT=/models/scoreboard/paddleocr
PCC_SCOREBOARD_CATALOG_VERSION=2026-09-09-rone
PCC_SCOREBOARD_MAX_CONCURRENT_JOBS=1
PCC_SCOREBOARD_TIMEOUT_SECONDS=120
PCC_SCOREBOARD_MAX_BYTES=10485760
PCC_SCOREBOARD_MAX_PIXELS=16777216
PCC_SCOREBOARD_DECODE_TIMEOUT_SECONDS=5

# Solana is Devnet-only. User-selected hackathon intent preselects every PCC chain feature.
# This example is not deployable evidence: implementation must refuse startup/chain work until
# every documented RPC, signer, program, metadata and finalized-evidence gate is satisfied.
# Never expose an RPC or signer as NEXT_PUBLIC_*.
PCC_SOLANA_ENABLED=true
PCC_SOLANA_DEVNET_ONLY=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_EXPECTED_GENESIS_HASH=GH7ome3EiwEr7tu9JuTh2dpYWBJK3z69Xm1ZE3MEE6JC
PCC_SOLANA_ENTRY_FEES_ENABLED=true
PCC_SOLANA_ESCROW_ENABLED=true
SOLANA_ESCROW_PROGRAM_ID=
PCC_SOLANA_CERTIFICATES_ENABLED=true
# Exact server-owned public metadata schema; do not accept a caller-selected schema/version.
SOLANA_CERTIFICATE_METADATA_SCHEMA_VERSION=pcc-certificate-v1
PCC_SOLANA_OPERATOR_SIGNER_PATH=/run/secrets/solana-operator.json
SOLANA_TEAM_CUSTODY_ADDRESS=
SOLANA_METADATA_STORAGE=IRYS_DEVNET
SOLANA_IRYS_URL=https://devnet.irys.xyz

# User-selected hackathon intent preselects the test-checkout switch. This is not evidence of
# a test account/key/webhook/method capability; runtime must fail closed without all of them.
PAYMONGO_ENABLED=true
# This hackathon allows only PayMongo test mode; enabling checkout requires test-only credentials/events.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated capability allowlist confirmed in the PayMongo test dashboard; leave blank to disable checkout.
PAYMONGO_TEST_PAYMENT_METHODS=gcash,qrph,maya
