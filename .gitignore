# Credentials and private runtime state
.env
.env.*
!.env.example
!.env.*.example
secrets/
*.pem
*.key
*keypair*.json
# Generated dependencies and build outputs
node_modules/
.venv*/
__pycache__/
.pytest_cache/
.next/
dist/
target/
.artifacts/
# Keep the approved local-model directory discoverable, but never track a model binary.
models/*
!models/.gitkeep
!models/face-recognition/
models/face-recognition/*
!models/face-recognition/.gitkeep
!models/scoreboard/
models/scoreboard/*
!models/scoreboard/.gitkeep
*.tsbuildinfo
# Deployment/runtime state
certbot/
backups/
data/
*.log

# Ephemeral external-reference material may be supplied to an agent ad hoc, but is never retained here.
docs/reference/SOURCE_MANIFEST.md
